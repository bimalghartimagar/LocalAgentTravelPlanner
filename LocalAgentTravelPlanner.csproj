<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Exclude the Tests and Api folders from this project -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Compile Remove="Api\**" />
    <None Remove="Api\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal middleware (RetryingChatClient, AnthropicOptionsInjector) to the
         test project so we can unit-test transient-failure handling without going through
         the full ChatClientFactory factory chain. -->
    <InternalsVisibleTo Include="LocalAgentTravelPlanner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic.SDK" Version="5.8.0" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.0.0-preview.251219.1" />
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="1.0.0-preview.251219.1" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.0.0-preview.251219.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.1.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.1.1-preview.1.25515.10" />
    <PackageReference Include="OllamaSharp" Version="5.4.12" />
    <!-- Pinned transitively via Microsoft.Agents.AI preview; bumped past 1.13.x to clear GHSA-g94r-2vxg-569j. -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.19.1" />
  </ItemGroup>

</Project>
